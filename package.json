{
  "name": "@moonshot-ai/code-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "postinstall": "pnpm prepare:fonts",
    "sync": "git submodule update --init --recursive",
    "build": "pnpm -r run build",
    "dev:desktop": "pnpm --filter kimi-code-app run dev",
    "dev:desktop:debug": "pnpm --filter kimi-code-app run dev -- --remote-debugging-port=9222",
    "dev:desktop:canary": "KIMI_DESKTOP_CANARY=true pnpm --filter kimi-code-app run dev",
    "dev:web": "pnpm --filter kimi-code-web run dev",
    "sync:web": "node scripts/sync-web-to-kimi-code.mjs",
    "package:macos": "bash apps/desktop/scripts/package-local-macos.sh",
    "typecheck": "pnpm --filter kimi-code-app run typecheck && pnpm --filter kimi-code-web run typecheck && pnpm --filter kimi-code-auth-login run typecheck",
    "lint": "oxlint --type-aware --config .oxlintrc.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.30.0",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.35",
    "@types/node": "^22.15.3",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "sharp": "^0.35.3",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4",
    "woff2-encoder": "2.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0"
}
