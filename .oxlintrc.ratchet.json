{
  "extends": [
    "./.oxlintrc.json"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "eslint/array-callback-return": "warn",
    "eslint/no-empty": [
      "warn",
      {
        "allowEmptyCatch": true
      }
    ],
    "eslint/no-fallthrough": "warn",
    "eslint/no-regex-spaces": "warn",
    "eslint/no-sequences": "warn",
    "eslint/no-useless-constructor": "warn",
    "eslint/prefer-const": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "oxc/bad-comparison-sequence": "warn",
    "oxc/no-accumulating-spread": "warn",
    "promise/no-callback-in-promise": "warn",
    "promise/no-promise-in-callback": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-namespace": "warn",
    "typescript/no-require-imports": "warn",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-useless-default-assignment": "warn",
    "typescript/prefer-promise-reject-errors": "warn",
    "typescript/related-getter-setter-pairs": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/use-unknown-in-catch-callback-variable": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-array-sort": "warn"
  },
  "overrides": [
    {
      "files": [
        "packages/*/src/**",
        "apps/*/src/**"
      ],
      "rules": {
        "eslint/no-console": "warn"
      }
    },
    {
      "files": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "apps/vis/*/src/**/*.ts",
        "apps/vis/*/src/**/*.tsx",
        "apps/vscode/webview-ui/src/**/*.ts",
        "apps/vscode/webview-ui/src/**/*.tsx"
      ],
      "rules": {
        "typescript/no-unnecessary-type-parameters": "warn",
        "typescript/no-unsafe-argument": "warn",
        "typescript/no-unsafe-assignment": "warn",
        "typescript/no-unsafe-call": "warn",
        "typescript/no-unsafe-member-access": "warn",
        "typescript/no-unsafe-return": "warn"
      }
    },
    {
      "files": [
        "apps/vis/web/**",
        "apps/vscode/webview-ui/**"
      ],
      "plugins": [
        "react"
      ],
      "rules": {
        "react/exhaustive-deps": "warn"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx"
      ],
      "plugins": [
        "vitest"
      ],
      "rules": {
        "vitest/no-conditional-expect": "warn",
        "vitest/no-disabled-tests": "warn",
        "vitest/valid-title": "warn",
        "eslint/no-unused-vars": "warn",
        "eslint/no-unsafe-optional-chaining": "warn",
        "eslint/no-console": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": [
        "**/examples/**/*.ts",
        "**/examples/**/*.tsx"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "apps/desktop/**/*",
        "packages/app-*/**/*",
        "scripts/**/*.mjs"
      ],
      "rules": {
        "eslint/accessor-pairs": "warn",
        "eslint/eqeqeq": "warn",
        "eslint/no-setter-return": "warn",
        "eslint/no-unneeded-ternary": "warn",
        "eslint/no-unused-vars": "warn",
        "eslint/no-var": "warn",
        "eslint/prefer-spread": "warn",
        "import/default": "warn",
        "import/extensions": "warn",
        "import/namespace": "warn",
        "import/no-cycle": "warn",
        "import/no-duplicates": "warn",
        "import/no-empty-named-blocks": "warn",
        "promise/no-return-in-finally": "warn",
        "typescript/await-thenable": "warn",
        "typescript/no-base-to-string": "warn",
        "typescript/no-confusing-non-null-assertion": "warn",
        "typescript/no-extraneous-class": "warn",
        "typescript/no-floating-promises": "warn",
        "typescript/no-implied-eval": "warn",
        "typescript/no-misused-promises": "warn",
        "typescript/no-misused-spread": "warn",
        "typescript/no-this-alias": "warn",
        "typescript/only-throw-error": "warn",
        "typescript/return-await": "warn",
        "typescript/restrict-template-expressions": "warn",
        "unicorn/no-new-array": "warn",
        "unicorn/no-this-assignment": "warn",
        "unicorn/no-useless-spread": "warn",
        "unicorn/require-module-specifiers": "warn",
        "vitest/no-standalone-expect": "warn"
      }
    }
  ],
  "ignorePatterns": [
    "dist/",
    "web-dist/",
    "coverage/",
    "node_modules/",
    "apps/*/scripts/",
    "docs/smoke-archive/",
    "packages/pi-tui/",
    "*.generated.ts"
  ]
}
