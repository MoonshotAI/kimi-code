{
  // Mirror the repo root tsconfig: the strictness flags must match the root
  // exactly. The `agent-core-v2` sources used to be included here too (it was
  // consumed through source `exports` and its `declare module` augmentations
  // fed interfaces like `AgentTaskInfoByKind`); that package is retired, and
  // the engine contracts kimi-inspect needs are now the local copies under
  // `src/legacy/`. Only the environment (DOM + vite client types) differs
  // from the root.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src",
    "vite",
    "vite.config.ts"
  ]
}
