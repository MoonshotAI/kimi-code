{
  "name": "kimi-code-app",
  "version": "1.4.3",
  "private": true,
  "description": "Kimi Code Desktop — Everything you love about Kimi Code, now on desktop",
  "author": "Moonshot AI",
  "homepage": "https://kimi.com/code",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "prepare:windows-bash": "node scripts/prepare-windows-bash.mjs",
    "predev": "npm run prepare:windows-bash && npm run build:native:screenshot && npm run build:native:clamshell",
    "predist:prebuilt-renderer": "npm run prepare:windows-bash",
    "build:native:screenshot": "node native/screenshot-window-list/build.mjs",
    "build:native:clamshell": "node native/clamshell-tool/build.mjs",
    "build": "npm run build:native:screenshot && npm run build:native:clamshell && tsdown",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "npm run prepare:windows-bash && npm run build:renderer",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:renderer",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:headless": "node e2e/run.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "dist": "npm run build:renderer && npm run dist:prebuilt-renderer --",
    "dist:prebuilt-renderer": "npm run build:native:screenshot && npm run build:native:clamshell && tsdown && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@toon-format/toon": "4.1.1",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "electron-updater": "^6.8.12",
    "node-pty": "^1.1.0",
    "semver": "^7.7.4",
    "typebox": "^1.3.30"
  },
  "devDependencies": {
    "@chenglou/pretext": "0.0.8",
    "@electron/rebuild": "4.2.0",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.35",
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/app-client": "workspace:*",
    "@moonshot-ai/app-components": "workspace:*",
    "@moonshot-ai/app-composer": "workspace:*",
    "@moonshot-ai/app-core": "workspace:*",
    "@moonshot-ai/app-i18n": "workspace:*",
    "@moonshot-ai/app-markdown": "workspace:*",
    "@moonshot-ai/app-ui": "workspace:*",
    "@moonshot-ai/kap-server": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/testkit": "workspace:^",
    "@moonshot-ai/vite-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@rive-app/canvas": "2.38.5",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.15.3",
    "fabric": "^7.4.0",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "photoswipe": "^5.4.4",
    "pinia": "4.0.3",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "shiki": "^4.3.0",
    "tar": "7.5.19",
    "tsdown": "0.22.0",
    "typescript": "6.0.2",
    "unplugin-icons": "^23.0.0",
    "uuid": "14.0.1",
    "vite": "^6.3.3",
    "vitest": "4.1.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-tsc": "~3.2.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "catalog:"
  }
}
