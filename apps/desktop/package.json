{
  "name": "@moonshot-ai/kimi-desktop",
  "version": "0.1.1-internal.0",
  "private": true,
  "license": "MIT",
  "description": "Kimi Code desktop client — an Electron shell around the Kimi web UI.",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/code-app",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "tsdown",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "prebuild": "npm run build:renderer",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:renderer",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest run",
    "postinstall": "electron-rebuild",
    "dist": "npm run build:renderer && tsdown && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kap-server": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/web-core": "workspace:*",
    "@moonshot-ai/web-i18n": "workspace:*",
    "@moonshot-ai/web-markdown": "workspace:*",
    "@moonshot-ai/web-ui": "workspace:*",
    "@chenglou/pretext": "0.0.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.17.0",
    "markstream-vue": "^1.0.4",
    "mermaid": "^11.15.0",
    "shiki": "^4.3.0",
    "stream-markdown": "^0.0.16",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "@electron/rebuild": "3.7.1",
    "@moonshot-ai/vite-preset": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "tsdown": "0.22.0",
    "typescript": "6.0.2",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.35",
    "unplugin-icons": "^23.0.0",
    "vite": "^6.3.3",
    "vitest": "4.1.4",
    "vue-tsc": "~3.2.0"
  }
}
