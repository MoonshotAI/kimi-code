{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "tests"],
  // The renderer (`src/renderer`) is a DOM/Vue app built by Vite
  // (`vite.renderer.config.ts`), not by the Node main-process typecheck, which
  // has no DOM lib. Keep it out of `tsc --noEmit` so pulling in web-core's DOM
  // APIs (e.g. `useIsDark`) does not break the main-process typecheck.
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "dist-app",
    "desktop-dist",
    "**/*.disabled/**",
    "**/*.disabled",
    "src/renderer/**"
  ]
}
