{
  "name": "kimi-code",
  "publisher": "moonshot-ai",
  "displayName": "Kimi Code",
  "description": "Official Kimi Code plugin for VS Code",
  "version": "0.8.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "assistant",
    "code",
    "chat",
    "agent",
    "mcp",
    "skills",
    "json",
    "autocomplete",
    "moonshot",
    "kimi",
    "moonshot-ai"
  ],
  "pricing": "Free",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "resources/kimi-icon-storefront.png",
  "contributes": {
    "configuration": {
      "title": "Kimi Code",
      "properties": {
        "kimi.serverUrl": {
          "type": "string",
          "default": "",
          "description": "External Kimi server URL (e.g. http://127.0.0.1:58627). When set, the extension connects to it instead of discovering or starting a local server."
        },
        "kimi.serverToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for the Kimi server. Defaults to the token file at <kimi-home>/server.token."
        },
        "kimi.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kimi CLI binary used to start the local server. Defaults to kimi on PATH, then <kimi-home>/bin/kimi."
        }
      }
    },
    "commands": [
      {
        "command": "kimi.openInTab",
        "title": "Kimi Code: Open in New Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "kimi.openInSideBar",
        "title": "Kimi Code: Open in Side Panel",
        "icon": "$(layout-sidebar-left)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kimi-sidebar",
          "title": "Kimi Code",
          "icon": "resources/kimi-icon.svg"
        }
      ]
    },
    "views": {
      "kimi-sidebar": [
        {
          "type": "webview",
          "id": "kimi.webview",
          "name": "Kimi Code"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "1.100.0",
    "tsdown": "0.22.0",
    "typescript": "6.0.2"
  }
}
