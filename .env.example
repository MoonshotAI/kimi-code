# macOS 本地签名打包凭证（pnpm package:macos 使用）。
# 复制本文件为 .env 并填值；.env 已被 .gitignore 忽略，切勿提交。
#
# 证书 / 公证 key 各支持两种形式，二选一（同名的 base64 值优先，_FILE 被忽略）：
#   1. base64 值：APPLE_CERTIFICATE_P12 / APPLE_NOTARIZATION_KEY_P8
#      （与 GitLab 项目 Settings -> CI/CD -> Variables 里的变量同值）
#   2. 文件路径：APPLE_CERTIFICATE_P12_FILE / APPLE_NOTARIZATION_KEY_P8_FILE
#      （脚本自己读文件转 base64）

# --- 证书（Developer ID Application .p12）---
# 形式 1：base64 编码的 .p12（单行，别带换行）
APPLE_CERTIFICATE_P12=
# 形式 2：.p12 文件路径
# APPLE_CERTIFICATE_P12_FILE=/path/to/developer-id.p12

# .p12 导出密码（不配则打包时交互式询问）
APPLE_CERTIFICATE_PASSWORD=

# --- 公证（App Store Connect API Key .p8）---
# 形式 1：base64 编码的 .p8
APPLE_NOTARIZATION_KEY_P8=
# 形式 2：.p8 文件路径
# APPLE_NOTARIZATION_KEY_P8_FILE=/path/to/AuthKey_XXXXXXXX.p8

# API Key ID（App Store Connect -> Users and Access -> Integrations）
APPLE_NOTARIZATION_KEY_ID=

# Issuer ID（同页面顶部，UUID 格式）
APPLE_NOTARIZATION_ISSUER_ID=
