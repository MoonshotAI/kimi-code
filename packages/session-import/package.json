{
  "name": "@moonshot-ai/session-import",
  "version": "0.0.1",
  "private": true,
  "description": "Convert external coding sessions into portable textual history and attachments.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "imports": { "#/*": "./src/*.ts" },
