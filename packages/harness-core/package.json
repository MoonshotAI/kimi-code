{
  "name": "@moonshot-ai/harness-core",
  "version": "0.1.0",
  "private": true,
  "description": "Kimi product harness built on agent-core",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "node --import tsx --import ./example/register-raw.mjs example/index.ts",
    "example:acp": "node --import tsx --import ./example/register-raw.mjs example/acp.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@moonshot-ai/agent-core": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/tree-sitter-bash": "workspace:^",
    "@mozilla/readability": "^0.6.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "jimp": "^1.6.1",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "openai": "^6.34.0",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.13",
    "undici": "^7.27.1",
    "ws": "^8.18.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.7.0",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6"
  }
}
