{
  "name": "@moonshot-ai/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Agent runtime primitives for Kimi",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx example/generate.ts",
    "example:loop": "tsx example/loop.ts",
    "example:session": "tsx example/session.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.49.0",
    "@jsquash/webp": "^1.5.0",
    "@noble/hashes": "^2.4.0",
    "@vue/reactivity": "^3.5.44",
    "jimp": "^1.6.1",
    "openai": "^6.34.0",
    "radashi": "^12.9.1",
    "undici": "^7.30.0",
    "xstate": "^5.32.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
