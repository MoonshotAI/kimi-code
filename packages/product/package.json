{
  "name": "@moonshot-ai/kimi-code-product",
  "version": "0.0.3",
  "private": true,
  "description": "Kimi Code product logic shared by clients and hosts.",
  "license": "MIT",
  "author": "Moonshot AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonshotAI/kimi-code.git",
    "directory": "packages/product"
  },
  "bugs": {
    "url": "https://github.com/MoonshotAI/kimi-code/issues"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./client-configs/node": {
      "types": "./src/client-configs/node/index.ts",
      "default": "./src/client-configs/node/index.ts"
    },
    "./session-rating": {
      "types": "./src/session-rating/common/index.ts",
      "default": "./src/session-rating/common/index.ts"
    },
    "./session-rating/node": {
      "types": "./src/session-rating/node/index.ts",
      "default": "./src/session-rating/node/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moonshot-ai/agent-core-v2": "workspace:^",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "zod": "catalog:"
  }
}
