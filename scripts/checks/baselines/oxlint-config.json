{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "deny",
    "pedantic": "warn",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist/",
    "dist-web/",
    "coverage/",
    "node_modules/",
    "apps/*/scripts/",
    "docs/smoke-archive/",
    "packages/pi-tui/",
    "*.generated.ts"
  ],
  "options": {
    "typeAware": true
  },
  "overrides": [
    {
      "env": null,
      "files": [
        "**/examples/**/*.ts",
        "**/examples/**/*.tsx"
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "no-console": "allow"
      }
    },
    {
      "env": null,
      "files": [
        "packages/minidb/src/worker/**/*.ts",
        "packages/minidb/src/codec.ts",
        "packages/minidb/src/crc32.ts",
        "packages/minidb/src/trigram.ts",
        "packages/minidb/src/text-postings.ts",
        "packages/minidb/src/text-index/tokenize.ts",
        "packages/minidb/src/gen-codec.ts",
        "packages/kap-server/src/search/worker/**/*.ts",
        "packages/kap-server/src/search/indexCore.ts",
        "packages/kap-server/src/search/match.ts"
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "import/extensions": "allow"
      }
    },
    {
      "env": null,
      "files": [
        "packages/minidb/**",
        "packages/klient/**",
        "packages/migration-legacy/**",
        "packages/acp-server/test/_helpers/scriptedProvider.ts"
      ],
      "globals": null,
      "plugins": null,
      "rules": {
        "import/extensions": "allow"
      }
    },
    {
      "env": null,
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx"
      ],
      "globals": null,
      "plugins": [
        "vitest"
      ],
      "rules": {
        "import/no-cycle": "allow",
        "no-console": "allow",
        "no-control-regex": "allow",
        "no-promise-executor-return": "allow",
        "no-shadow": "allow",
        "no-unsafe-optional-chaining": "allow",
        "no-unused-vars": "allow",
        "typescript/no-explicit-any": "allow",
        "typescript/no-meaningless-void-operator": "allow",
        "typescript/no-non-null-assertion": "allow",
        "typescript/no-redundant-type-constituents": "allow",
        "typescript/no-unsafe-argument": "allow",
        "typescript/no-unsafe-assignment": "allow",
        "typescript/no-unsafe-member-access": "allow",
        "typescript/require-array-sort-compare": "allow",
        "typescript/unbound-method": "allow",
        "unicorn/no-useless-spread": "allow",
        "unicorn/prefer-event-target": "allow",
        "vitest/expect-expect": [
          "deny",
          {
            "assertFunctionNames": [
              "expect",
              "expectTypeOf",
              "assert",
              "assertType",
              "expect*",
              "assert*",
              "*.expect*"
            ]
          }
        ],
        "vitest/hoisted-apis-on-top": "deny",
        "vitest/no-commented-out-tests": "warn",
        "vitest/no-conditional-expect": "allow",
        "vitest/no-conditional-in-test": "allow",
        "vitest/no-conditional-tests": "deny",
        "vitest/no-disabled-tests": "allow",
        "vitest/no-focused-tests": "deny",
        "vitest/no-identical-title": "deny",
        "vitest/no-standalone-expect": "deny",
        "vitest/prefer-snapshot-hint": "deny",
        "vitest/require-awaited-expect-poll": "deny",
        "vitest/require-local-test-context-for-concurrent-snapshots": "deny",
        "vitest/require-mock-type-parameters": "allow",
        "vitest/require-to-throw-message": "allow",
        "vitest/valid-describe-callback": "deny",
        "vitest/valid-expect": "allow",
        "vitest/valid-expect-in-promise": "deny",
        "vitest/valid-title": "allow",
        "vitest/warn-todo": "allow"
      }
    }
  ],
  "plugins": [
    "unicorn",
    "typescript",
    "import",
    "promise",
    "node"
  ],
  "rules": {
    "accessor-pairs": "warn",
    "array-callback-return": "warn",
    "block-scoped-var": "warn",
    "constructor-super": "deny",
    "eqeqeq": "deny",
    "for-direction": "deny",
    "getter-return": "deny",
    "import/default": "deny",
    "import/extensions": [
      "deny",
      "ignorePackages",
      {
        "js": "never",
        "ts": "never",
        "tsx": "never"
      }
    ],
    "import/first": "warn",
    "import/max-dependencies": "allow",
    "import/namespace": "deny",
    "import/no-absolute-path": "warn",
    "import/no-cycle": "deny",
    "import/no-duplicates": "warn",
    "import/no-empty-named-blocks": "warn",
    "import/no-mutable-exports": "warn",
    "import/no-named-as-default": "warn",
    "import/no-named-as-default-member": "warn",
    "import/no-self-import": "deny",
    "import/no-unassigned-import": "allow",
    "max-classes-per-file": "allow",
    "max-depth": "allow",
    "max-lines": "allow",
    "max-lines-per-function": "allow",
    "max-nested-callbacks": "allow",
    "no-array-constructor": "warn",
    "no-async-promise-executor": "deny",
    "no-await-in-loop": "allow",
    "no-caller": "deny",
    "no-case-declarations": "warn",
    "no-class-assign": "deny",
    "no-compare-neg-zero": "deny",
    "no-cond-assign": "deny",
    "no-console": "warn",
    "no-const-assign": "deny",
    "no-constant-binary-expression": "deny",
    "no-constant-condition": "deny",
    "no-constructor-return": "warn",
    "no-control-regex": "allow",
    "no-debugger": "deny",
    "no-delete-var": "deny",
    "no-dupe-class-members": "deny",
    "no-dupe-else-if": "deny",
    "no-dupe-keys": "deny",
    "no-duplicate-case": "deny",
    "no-else-return": "warn",
    "no-empty-character-class": "deny",
    "no-empty-pattern": "deny",
    "no-empty-static-block": "deny",
    "no-eval": "deny",
    "no-ex-assign": "deny",
    "no-extend-native": "warn",
    "no-extra-bind": "warn",
    "no-extra-boolean-cast": "deny",
    "no-fallthrough": "warn",
    "no-func-assign": "deny",
    "no-global-assign": "deny",
    "no-implied-eval": "warn",
    "no-import-assign": "deny",
    "no-inline-comments": "allow",
    "no-inner-declarations": "warn",
    "no-invalid-regexp": "deny",
    "no-irregular-whitespace": "deny",
    "no-iterator": "deny",
    "no-lonely-if": "warn",
    "no-loop-func": "warn",
    "no-loss-of-precision": "deny",
    "no-misleading-character-class": "deny",
    "no-negated-condition": "allow",
    "no-new": "warn",
    "no-new-native-nonconstructor": "deny",
    "no-new-wrappers": "warn",
    "no-nonoctal-decimal-escape": "deny",
    "no-obj-calls": "deny",
    "no-object-constructor": "warn",
    "no-promise-executor-return": "warn",
    "no-prototype-builtins": "warn",
    "no-redeclare": "warn",
    "no-self-assign": "deny",
    "no-self-compare": "warn",
    "no-setter-return": "deny",
    "no-shadow": "allow",
    "no-shadow-restricted-names": "deny",
    "no-sparse-arrays": "deny",
    "no-this-before-super": "deny",
    "no-throw-literal": "allow",
    "no-unassigned-vars": "deny",
    "no-underscore-dangle": "allow",
    "no-unexpected-multiline": "warn",
    "no-unmodified-loop-condition": "warn",
    "no-unneeded-ternary": "warn",
    "no-unreachable": "deny",
    "no-unsafe-finally": "deny",
    "no-unsafe-negation": "deny",
    "no-unsafe-optional-chaining": "deny",
    "no-unused-expressions": "deny",
    "no-unused-labels": "deny",
    "no-unused-private-class-members": "deny",
    "no-unused-vars": "deny",
    "no-useless-backreference": "deny",
    "no-useless-call": "warn",
    "no-useless-catch": "deny",
    "no-useless-concat": "warn",
    "no-useless-constructor": "warn",
    "no-useless-escape": "deny",
    "no-useless-rename": "deny",
    "no-useless-return": "allow",
    "no-warning-comments": "allow",
    "no-with": "deny",
    "node/no-exports-assign": "warn",
    "node/no-new-require": "warn",
    "node/no-path-concat": "warn",
    "prefer-promise-reject-errors": "warn",
    "preserve-caught-error": "warn",
    "promise/always-return": "allow",
    "promise/no-callback-in-promise": "warn",
    "promise/no-multiple-resolved": "warn",
    "promise/no-new-statics": "deny",
    "promise/no-promise-in-callback": "warn",
    "promise/no-return-in-finally": "warn",
    "promise/valid-params": "warn",
    "radix": "allow",
    "require-await": "allow",
    "require-unicode-regexp": "allow",
    "require-yield": "deny",
    "sort-vars": "allow",
    "symbol-description": "allow",
    "typescript/await-thenable": "deny",
    "typescript/ban-ts-comment": "warn",
    "typescript/ban-types": "allow",
    "typescript/consistent-return": "allow",
    "typescript/consistent-type-imports": "allow",
    "typescript/no-array-delete": "deny",
    "typescript/no-base-to-string": "deny",
    "typescript/no-confusing-non-null-assertion": "warn",
    "typescript/no-confusing-void-expression": "warn",
    "typescript/no-deprecated": "allow",
    "typescript/no-duplicate-enum-values": "deny",
    "typescript/no-duplicate-type-constituents": "allow",
    "typescript/no-explicit-any": "allow",
    "typescript/no-extra-non-null-assertion": "deny",
    "typescript/no-extraneous-class": "warn",
    "typescript/no-floating-promises": "deny",
    "typescript/no-for-in-array": "deny",
    "typescript/no-generated-empty-object-type": "allow",
    "typescript/no-implied-eval": "deny",
    "typescript/no-meaningless-void-operator": "deny",
    "typescript/no-misused-new": "deny",
    "typescript/no-misused-promises": "deny",
    "typescript/no-misused-spread": "deny",
    "typescript/no-mixed-enums": "warn",
    "typescript/no-non-null-asserted-nullish-coalescing": "warn",
    "typescript/no-non-null-asserted-optional-chain": "deny",
    "typescript/no-non-null-assertion": "allow",
    "typescript/no-redundant-type-constituents": "deny",
    "typescript/no-this-alias": "deny",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-parameter-property-assignment": "deny",
    "typescript/no-unnecessary-template-expression": "warn",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/no-unnecessary-type-constraint": "warn",
    "typescript/no-unnecessary-type-conversion": "warn",
    "typescript/no-unnecessary-type-parameters": "allow",
    "typescript/no-unsafe-argument": "allow",
    "typescript/no-unsafe-assignment": "allow",
    "typescript/no-unsafe-call": "allow",
    "typescript/no-unsafe-declaration-merging": "deny",
    "typescript/no-unsafe-enum-assignment": "warn",
    "typescript/no-unsafe-enum-comparison": "warn",
    "typescript/no-unsafe-function-type": "allow",
    "typescript/no-unsafe-member-access": "allow",
    "typescript/no-unsafe-return": "allow",
    "typescript/no-unsafe-type-assertion": "allow",
    "typescript/no-unsafe-unary-minus": "deny",
    "typescript/no-useless-default-assignment": "allow",
    "typescript/no-useless-empty-export": "deny",
    "typescript/no-wrapper-object-types": "deny",
    "typescript/only-throw-error": "deny",
    "typescript/prefer-as-const": "deny",
    "typescript/prefer-enum-initializers": "warn",
    "typescript/prefer-includes": "warn",
    "typescript/prefer-namespace-keyword": "deny",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/prefer-promise-reject-errors": "allow",
    "typescript/prefer-readonly-parameter-types": "allow",
    "typescript/prefer-ts-expect-error": "warn",
    "typescript/related-getter-setter-pairs": "warn",
    "typescript/require-array-sort-compare": "deny",
    "typescript/require-await": "allow",
    "typescript/restrict-plus-operands": "warn",
    "typescript/restrict-template-expressions": "deny",
    "typescript/return-await": "deny",
    "typescript/strict-boolean-expressions": "allow",
    "typescript/strict-void-return": "allow",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/triple-slash-reference": "deny",
    "typescript/unbound-method": "deny",
    "typescript/use-unknown-in-catch-callback-variable": "allow",
    "unicorn/catch-error-name": "warn",
    "unicorn/consistent-assert": "warn",
    "unicorn/consistent-empty-array-spread": "warn",
    "unicorn/consistent-function-scoping": "allow",
    "unicorn/error-message": "warn",
    "unicorn/escape-case": "warn",
    "unicorn/explicit-length-check": "warn",
    "unicorn/new-for-builtins": "warn",
    "unicorn/no-accessor-recursion": "warn",
    "unicorn/no-array-callback-reference": "allow",
    "unicorn/no-array-fill-with-reference-type": "warn",
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/no-await-in-promise-methods": "deny",
    "unicorn/no-confusing-array-with": "warn",
    "unicorn/no-empty-file": "deny",
    "unicorn/no-hex-escape": "warn",
    "unicorn/no-immediate-mutation": "warn",
    "unicorn/no-instanceof-array": "warn",
    "unicorn/no-instanceof-builtins": "warn",
    "unicorn/no-invalid-fetch-options": "deny",
    "unicorn/no-invalid-remove-event-listener": "deny",
    "unicorn/no-lonely-if": "allow",
    "unicorn/no-negated-condition": "allow",
    "unicorn/no-negation-in-equality-check": "warn",
    "unicorn/no-new-array": "deny",
    "unicorn/no-new-buffer": "warn",
    "unicorn/no-object-as-default-parameter": "warn",
    "unicorn/no-single-promise-in-promise-methods": "deny",
    "unicorn/no-static-only-class": "warn",
    "unicorn/no-thenable": "deny",
    "unicorn/no-this-assignment": "warn",
    "unicorn/no-typeof-undefined": "warn",
    "unicorn/no-unnecessary-array-flat-depth": "warn",
    "unicorn/no-unnecessary-array-splice-count": "warn",
    "unicorn/no-unnecessary-await": "deny",
    "unicorn/no-unnecessary-slice-end": "warn",
    "unicorn/no-unreadable-iife": "warn",
    "unicorn/no-useless-error-capture-stack-trace": "warn",
    "unicorn/no-useless-fallback-in-spread": "deny",
    "unicorn/no-useless-length-check": "deny",
    "unicorn/no-useless-promise-resolve-reject": "warn",
    "unicorn/no-useless-spread": "deny",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/no-useless-undefined": "allow",
    "unicorn/prefer-add-event-listener": "allow",
    "unicorn/prefer-array-find": "warn",
    "unicorn/prefer-array-flat": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-array-some": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/prefer-blob-reading-methods": "warn",
    "unicorn/prefer-code-point": "warn",
    "unicorn/prefer-date-now": "warn",
    "unicorn/prefer-dom-node-append": "warn",
    "unicorn/prefer-dom-node-dataset": "warn",
    "unicorn/prefer-dom-node-remove": "warn",
    "unicorn/prefer-event-target": "warn",
    "unicorn/prefer-import-meta-properties": "warn",
    "unicorn/prefer-math-min-max": "warn",
    "unicorn/prefer-math-trunc": "warn",
    "unicorn/prefer-native-coercion-functions": "warn",
    "unicorn/prefer-node-protocol": "deny",
    "unicorn/prefer-number-coercion": "allow",
    "unicorn/prefer-prototype-methods": "warn",
    "unicorn/prefer-query-selector": "warn",
    "unicorn/prefer-regexp-test": "warn",
    "unicorn/prefer-set-has": "warn",
    "unicorn/prefer-set-size": "deny",
    "unicorn/prefer-single-call": "allow",
    "unicorn/prefer-string-replace-all": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/prefer-string-starts-ends-with": "deny",
    "unicorn/prefer-top-level-await": "warn",
    "unicorn/prefer-type-error": "warn",
    "unicorn/require-module-specifiers": "warn",
    "unicorn/require-number-to-fixed-digits-argument": "warn",
    "unicorn/require-post-message-target-origin": "warn",
    "unicorn/throw-new-error": "warn",
    "use-isnan": "deny",
    "valid-typeof": "deny"
  },
  "settings": {
    "jest": {
      "version": null
    },
    "jsdoc": {
      "augmentsExtendsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "ignoreInternal": false,
      "ignorePrivate": false,
      "ignoreReplacesDocs": true,
      "implementsReplacesDocs": false,
      "overrideReplacesDocs": true,
      "tagNamePreference": {}
    },
    "jsx-a11y": {
      "attributes": {},
      "components": {},
      "polymorphicPropName": null
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "componentWrapperFunctions": [],
      "formComponents": [],
      "linkComponents": [],
      "version": null
    },
    "vitest": {
      "typecheck": false
    }
  }
